#include <iostream>
using namespace std;
int count = 0;
struct Node{
    int data;
    Node * next;
};
Node* top = NULL;
void push(int value){
    Node * newNode = new Node();
    newNode -> data = value;
    newNode -> next = top;
    top = newNode;
    count++;
    cout<<value<<" Pushed sucesfully"<<endl;
    
}
void size(){
    cout<<"Size = "<<count<<endl;
}
void pop(){
    count--;
    Node*temp= top;
    if(top == NULL){
        cout<<"Stack is Empty"<<endl;
        
    }
    top = top->next;
    delete temp;
    cout<<"Deleted SucessFully"<<endl;
}
void isEmpty(){
    if(top==NULL){
        cout<<"Stack is Empty"<<endl;
    }
    else{
        cout<<"Stack is not empty"<<endl;
    }
}
void Top(){
    cout<<"Top ele is :"<<top->data<<endl;
}
void isFull(){
    Node * temp = top;
    while(temp!= NULL){
        cout<<temp->data<<" ";
        temp = temp->next;
    }cout<<endl;
}
int main(){
    size();
    isEmpty();
    push(10);
    push(20);
    push(30);
    push(50);
    push(60);
    isFull();
    Top();
    push(15);
    pop();
    Top();
    pop();
    pop();
    pop();
    pop();
    push(26);
    isEmpty();
    Top();
    
    
    size();
}
